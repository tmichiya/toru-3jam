	"comment_poems": "1行 = 言葉の並び。{\"t\": 言葉, \"visible_in\": 色} はその色の時だけ見える言葉。見える色は、たいてい別の詩 (あとで手に入る詩) の色の言葉にしてある",
	"poems": [
		{
			"id": "p1", "title": "一",
			"lines": [
				["灰色", "部屋", "ひとり"],
				["赤い", "涙", "逆さ"],
				[{ "t": "ぬくもり", "visible_in": "purple" }, { "t": "風", "visible_in": "white" }]
			]
		},
		{
			"id": "p2", "title": "二",
			"lines": [
				["青い", "夜", { "t": "ずれる", "visible_in": "red" }],
				["やさしい", "声", "眠る"],
				["緑の", { "t": "夢", "visible_in": "gold" }, { "t": "明るい", "visible_in": "white" }]
			]
		},
		{
			"id": "p3", "title": "三",
			"lines": [
				["紫の", "扉", "閉じる"],
				["なくした", { "t": "鍵", "visible_in": "green" }],
				["金色", "光", { "t": "鳥", "visible_in": "white" }]
			]
		},
		{
			"id": "p4", "title": "四",
			"lines": [
				["きらきらした", "星", "窓"],
				["暗い", "過去", { "t": "歌", "visible_in": "red" }],
				["白い", { "t": "川", "visible_in": "blue" }]
			]
		}
	],

